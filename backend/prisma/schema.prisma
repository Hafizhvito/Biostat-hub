// Skema database Riset Hub — lihat docs/PANDUAN-DEVELOPER.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Section {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  videos      Video[]

  @@map("sections")
}

model Video {
  id          Int      @id @default(autoincrement())
  sectionId   Int      @map("section_id")
  title       String
  youtubeUrl  String   @map("youtube_url")
  description String   @default("") @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@map("videos")
}

model Quiz {
  id        Int            @id @default(autoincrement())
  title     String         @default("Kuis")
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  questions QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id           Int          @id @default(autoincrement())
  quizId       Int          @map("quiz_id")
  questionText String       @map("question_text")
  imageUrl     String       @default("") @map("image_url")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id         Int          @id @default(autoincrement())
  questionId Int          @map("question_id")
  optionText String       @map("option_text")
  isCorrect  Boolean      @default(false) @map("is_correct")
  sortOrder  Int          @default(0) @map("sort_order")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_options")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model SiteSettings {
  id              Int      @id @default(1)
  heroTitle       String   @map("hero_title")
  heroDescription String   @db.Text @map("hero_description")
  contactEmail    String   @default("risethub.support@gmail.com") @map("contact_email")
  calculatorUrl   String   @default("") @map("calculator_url")
  materialDisplayMode String @default("flat") @map("material_display_mode")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Glossary {
  id         Int      @id @default(autoincrement())
  term       String
  definition String  @db.Text
  example    String? @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("glossary")
}

model Download {
  id            Int      @id @default(autoincrement())
  title         String
  description   String   @default("") @db.Text
  category      String
  filename      String
  originalName  String   @map("original_name")
  fileSize      Int      @map("file_size")
  downloadCount Int      @default(0) @map("download_count")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("downloads")
}

model WizardImage {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("") @db.Text
  filename    String
  sortOrder   Int      @default(0) @map("order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("wizard_images")
}

model CalculatorLink {
  id        Int      @id @default(autoincrement())
  title     String
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("calculator_links")
}
